# Paths are local configuration. Do not commit real data or secrets.
MSP_HISTORY_ROOT=./rd/1_msp_db
AUTOMSP_ROOT=./rd/AutoMSP
MSP_REPORT_TEMPLATE=./rd/AutoMSP/template.docx
MSP_CODES_FILE=./rd/AutoMSP/Коды.xlsx
APP_DATA_DIR=./var
DATABASE_URL=sqlite:///./var/ai_vector.db

LLM_PROVIDER=deterministic
LLM_QUERY_MODEL=glm-5.1
LLM_NARRATIVE_MODEL=glm-5.1

ZAI_BASE_URL=https://api.z.ai/api/paas/v4/
ZAI_API_KEY=

GNIVC_BASE_URL=https://api.ai.gnivc.ru/v1
GNIVC_API_KEY=
GNIVC_QUERY_MODEL=qwen3.6-35b
GNIVC_NARRATIVE_MODEL=qwen3.5-122b

# The analytical chat stays on LLM_PROVIDER; only the report rebuild button
# uses GigaChat from the same GNIVC OpenAI-compatible gateway and API key.
REPORT_SYNTHESIS_PROVIDER=gnivc_gigachat
REPORT_SYNTHESIS_MODEL=GigaChat-Max

LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_DATA_POLICY=metadata_only
ALLOW_EXTERNAL_LLM_DATA=false
ANALYTIC_AGENT_V2=false
ANALYTIC_PLANNER_MODE=model_first
# No normal model-call limit. Only protects against a non-converging planner.
ANALYTIC_PLANNER_EMERGENCY_MAX_STEPS=32
# No global analysis deadline; each provider call uses LLM_TIMEOUT_SECONDS.
# Frontend uses the same rollout switch with the Vite prefix:
VITE_ANALYTIC_AGENT_V2=false

APP_LOCALE=ru_RU
APP_TIMEZONE=Europe/Moscow
CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
